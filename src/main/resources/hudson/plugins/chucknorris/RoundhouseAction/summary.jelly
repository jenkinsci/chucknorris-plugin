<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler">
    <tr>
        <td>
            <link rel="stylesheet" type="text/css" href="${resURL}/plugin/chucknorris/css/chucknorris.css"/>
            <img src="${resURL}/plugin/chucknorris/images/icon.png" width="48" height="48" alt="${it.displayName}"/>
        </td>
        <td class="chuck-fact">
            <span class="chuck-norris-marker" data-chuck-style="${it.style.cssClass}">${it.fact}</span>
        </td>
    </tr>
    <st:adjunct includes="hudson.plugins.chucknorris.RoundhouseAction.chucknorris"/>
</j:jelly>
