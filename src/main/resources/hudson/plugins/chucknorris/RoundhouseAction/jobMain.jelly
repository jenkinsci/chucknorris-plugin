<?jelly escape-by-default='true'?>
<!--
  Project page: Chuck's image in the main area, floated to the right so it sits
  next to the blocks that follow (test results, permalinks). The fact itself
  stays in floatingBox.jelly.
-->
<j:jelly xmlns:j="jelly:core">
    <link rel="stylesheet" type="text/css" href="${resURL}/plugin/chucknorris/css/chucknorris.css"/>
    <div class="chuck-job-image">
        <img class="chuck-image ${it.style.cssClass}" src="${resURL}/plugin/chucknorris/images/${it.style.imageFile}" alt=""/>
    </div>
</j:jelly>
