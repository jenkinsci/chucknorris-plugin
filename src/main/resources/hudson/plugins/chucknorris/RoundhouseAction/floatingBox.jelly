<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core">
    <link rel="stylesheet" type="text/css" href="${resURL}/plugin/chucknorris/css/chucknorris.css"/>
    <div class="chuck-floating">
        <div class="chuck-floating__fact">
            <img src="${resURL}/plugin/chucknorris/images/icon.png" width="16" height="16" alt="${from.displayName}"/>
            <span>${from.fact}</span>
            <j:if test="${from.newFactAllowed}">
                <form method="post" action="${rootURL}/${from.actionUrl}newFact" class="chuck-floating__new-fact">
                    <button type="submit" class="jenkins-button" tooltip="${%Pick another fact for this build}">${%New fact}</button>
                </form>
            </j:if>
        </div>
    </div>
</j:jelly>
