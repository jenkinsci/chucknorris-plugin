<?xml version="1.0" encoding="UTF-8"?>

<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry field="quiet">
        <f:checkbox title="${%Quiet}"/>
    </f:entry>
    <f:entry field="showImage">
        <f:checkbox title="${%Show image}" default="true"/>
    </f:entry>
</j:jelly>